#!/usr/bin/env bash
# Pre-commit hook: formats the staged Dart files, stages them again, then
# runs the analyzer with the same flags as CI. `mise run setup` points
# git at this directory (core.hooksPath).

staged_dart=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' | grep -v '\.g\.dart$')

if [ -z "$staged_dart" ]; then
  exit 0
fi

# Resolve dart and flutter via mise if available, fall back to PATH
DART="dart"
FLUTTER="flutter"
if command -v mise &>/dev/null; then
  DART="$(mise which dart 2>/dev/null || echo dart)"
  FLUTTER="$(mise which flutter 2>/dev/null || echo flutter)"
fi

# Format the staged files and stage them again. A file with unstaged
# changes as well is left alone, since staging it again would commit those
# changes too. CI's format check still sees it.
unstaged=$(git diff --name-only)
to_format=$(comm -23 <(echo "$staged_dart" | sort) <(echo "$unstaged" | sort))
partly_staged=$(comm -12 <(echo "$staged_dart" | sort) <(echo "$unstaged" | sort))
if [ -n "$partly_staged" ]; then
  echo "Not formatting files with unstaged changes:"
  echo "$partly_staged"
fi
if [ -n "$to_format" ]; then
  echo "$to_format" | xargs "$DART" format
  echo "$to_format" | xargs git add
fi

# The whole project, not just the staged files: a change in one file can
# break another.
echo "Running flutter analyze --fatal-infos..."
if ! analysis=$("$FLUTTER" analyze --fatal-infos 2>&1); then
  echo "$analysis"
  echo "❌ Analysis failed. Fix issues before committing."
  exit 1
fi
echo "$analysis" | tail -1

exit 0
