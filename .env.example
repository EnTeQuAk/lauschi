# Developer environment — loaded by mise for scripts and tooling.
# NOT passed to Flutter builds (use .env.app for that).

# Spotify API credentials (for catalog validation scripts)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Model host for the AI catalog commands (curate, audit): ollama (default)
# or opencode. Each host reads its own key.
LAUSCHI_MODEL_HOST=
OLLAMA_API_KEY=
OPENCODE_API_KEY=

# Brave Search API key (for web search in review scripts)
BRAVE_API_KEY=

# Sentry (duplicated here so scripts can use it too if needed)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Public reference index used by the agents' lookup_reference_lines tool, the
# catalog QA and `lauschi-catalog reference` (optional; they answer 'not
# configured' without it). The path of a Python file outside the repo whose
# `source()` returns a `lauschi_catalog.reference.ReferenceSource`.
REFERENCE_INDEX_SOURCE=
# The QA's override file next to it (see lauschi_catalog.catalog.reference_map).
REFERENCE_INDEX_MAP=
